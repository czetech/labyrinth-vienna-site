---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import path from "pathe";
import ContentImage from "~/components/ContentImage.astro";
import SeminarTabs from "~/components/SeminarTabs.tsx";
import { renderMarkdown } from "~/lib/markdown.ts";

const { seminar } = Astro.props;

const teacher = await getEntry(
  "teachers",
  path.basename(seminar.data.teacher, ".yaml"),
);

const videos: { title: string; id: string }[] = teacher.data.videos ?? [];

// Render seminar markdown body to HTML
const seminarHtml = await renderMarkdown(seminar.body ?? "");

// Build teacher HTML: description + YouTube embeds
let teacherHtml = await renderMarkdown(teacher.data.description ?? "");

if (videos.length > 0) {
  const videoEmbeds = videos
    .map((video) => {
      const match = video.id.match(
        /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9-_]{11})/,
      );
      const videoId = match?.[1];
      if (!videoId) return "";
      return `<div class="mt-6"><iframe src="https://www.youtube-nocookie.com/embed/${videoId}" title="${video.title}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width:100%;aspect-ratio:16/9;border:0;border-radius:0.5rem"></iframe></div>`;
    })
    .join("");
  teacherHtml += videoEmbeds;
}

export const getStaticPaths = async () => {
  return (await getCollection("seminars")).map((seminar) => ({
    params: { name: seminar.id },
    props: { seminar },
  }));
};
---

<BaseLayout>
  <article class="max-w-192 px-4">
    <div class="mb-8 grid grid-cols-2 gap-x-4 md:gap-x-8">
      <ContentImage
        path={teacher.data.image}
        class="max-h-64 rounded-2xl object-cover"
      />
      <div class="flex flex-col gap-y-2">
        <h1 class="flex flex-col font-serif text-xl md:text-3xl">
          <span class="font-bold uppercase">{seminar.data.mainTitle}</span>
          <span>{seminar.data.additionalTitle}</span>
        </h1>
        <span class="md:text-lg">with</span>
        <span class="font-serif text-lg font-bold md:text-2xl">
          {teacher.data.name}
        </span>
        <span class="md:text-lg">18th - 23rd August 2026</span>
      </div>
    </div>
    <SeminarTabs
      client:load
      seminarHtml={seminarHtml}
      teacherHtml={teacherHtml}
    />
  </article>
</BaseLayout>
